    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Point the camera at your meal for calorie suggestions, or let it follow your movements to score the Floor Age check. Everything is checked on your iPhone and never saved or sent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apunta la cámara a tu comida para recibir sugerencias de calorías, o deja que siga tus movimientos para puntuar la prueba Floor Age. Todo se analiza en tu iPhone y nunca se guarda ni se envía."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कैलोरी के सुझाव के लिए कैमरा अपने खाने की ओर करें, या Floor Age चेक में कैमरे को अपनी हरकतें गिनने दें। सब कुछ आपके iPhone पर ही जांचा जाता है, और कभी सेव नहीं होता, न कहीं भेजा जाता है।"
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "comment" : "Privacy - Health Share Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Floor Age reads your sleep from Apple Health to show how long you sleep. It never changes your Health data or sends it anywhere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Floor Age lee tus datos de sueño de Apple Health para mostrarte cuánto duermes. Nunca modifica tus datos de salud ni los envía a ninguna parte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Floor Age आपकी नींद का डेटा Apple Health से पढ़ता है, ताकि दिखा सके कि आप कितनी देर सोते हैं। यह आपका Health डेटा कभी नहीं बदलता, और न ही उसे कहीं भेजता है।"
          }
        }
      }
    },
    "NSMotionUsageDescription" : {
      "comment" : "Privacy - Motion Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Floor Age counts your daily steps on this iPhone. Your steps never leave your phone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Floor Age cuenta tus pasos diarios en este iPhone. Tus pasos nunca salen de tu teléfono."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Floor Age इस iPhone पर आपके रोज़ के कदम गिनता है। आपके कदमों का डेटा कभी आपके फ़ोन से बाहर नहीं जाता।"
          }
        }
      }
    }
  },
  "version" : "1.2"
}
