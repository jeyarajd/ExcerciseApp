            "value": "Gently squeeze the back buttock."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पीछे वाले कूल्हे को हल्का कसें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprieta suavemente el glúteo de atrás."
          }
        }
      }
    },
    "half_kneel.cue.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Breathe slowly."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "धीरे-धीरे साँस लें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Respira despacio."
          }
        }
      }
    },
    "half_kneel.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Half-kneel. On a soft mat, kneel on one knee with the other foot flat in front of you. Stand your body tall and hold. We'll swap sides halfway."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आधा घुटना टेकना। नरम मैट पर एक घुटना टेकें और दूसरा पैर सामने ज़मीन पर सपाट रखें। शरीर को सीधा रखें और रुकें। आधे समय पर तरफ़ बदलेंगे।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Media rodilla. Sobre una esterilla blanda, apoya una rodilla y el otro pie plano delante. Mantén el cuerpo erguido y aguanta. A mitad cambiaremos de lado."
          }
        }
      }
    },
    "half_kneel.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Half-Kneel Hold"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आधा घुटना टेककर रुकना"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Media rodilla sostenida"
          }
        }
      }
    },
    "half_kneel.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put a folded towel under your knee. Skip this if kneeling hurts."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घुटने के नीचे मुड़ा हुआ तौलिया रखें। घुटना टेकने में दर्द हो तो इसे छोड़ दें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon una toalla doblada bajo la rodilla. Sáltalo si arrodillarte te duele."
          }
        }
      }
    },
    "kegel.And relax": {
      "extractionState": "manual",
      "localizations": {
