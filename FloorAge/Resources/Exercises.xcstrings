    "feet_together_balance.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feet together. Stand behind a sturdy chair and hold its back. Bring your feet together and stand tall. Let go a little if you feel steady."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पैर मिलाकर खड़े हों। एक मज़बूत कुर्सी के पीछे खड़े होकर उसकी पीठ पकड़ें। पैरों को मिलाएँ और सीधे खड़े रहें। संतुलन बने तो पकड़ थोड़ी ढीली करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pies juntos. Ponte detrás de una silla firme y sujeta el respaldo. Junta los pies y mantente erguido. Si te sientes estable, suelta un poco."
          }
        }
      }
    },
    "feet_together_balance.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feet Together Balance"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पैर मिलाकर संतुलन"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Equilibrio con pies juntos"
          }
        }
      }
    },
    "feet_together_balance.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep a sturdy chair or a wall within reach."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मज़बूत कुर्सी या दीवार पास रखें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten una silla firme o una pared a mano."
          }
        }
      }
    },
