{
  "sourceLanguage": "en",
  "strings": {
    "arm_raise.cue.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shoulders relaxed."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कंधे ढीले रखें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hombros relajados."
          }
        }
      }
    },
    "arm_raise.cue.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Breathe in as you lift."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उठाते समय सांस लें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inhala al subir."
          }
        }
      }
    },
    "arm_raise.cue.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Breathe out as you lower."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नीचे लाते समय सांस छोड़ें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exhala al bajar."
          }
        }
      }
    },
    "arm_raise.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Side arm raises. Lift your arms out to the side up to shoulder height, then lower."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हाथ बगल में उठाना। दोनों हाथ बगल से कंधों की ऊंचाई तक उठाएं, फिर नीचे लाएं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elevación lateral de brazos. Sube los brazos hacia los lados hasta la altura de los hombros y luego bájalos."
          }
        }
      }
    },
    "arm_raise.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Side Arm Raise"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हाथ बगल में उठाना"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elevación lateral de brazos"
          }
        }
      }
    },
    "calf_raise.cue.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rise straight up."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सीधे ऊपर उठें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube en línea recta."
          }
        }
      }
    },
    "calf_raise.cue.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause at the top."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऊपर थोड़ा रुकें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa arriba."
          }
        }
      }
    },
    "calf_raise.cue.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower slowly."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "धीरे से नीचे आएं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja despacio."
          }
        }
      }
    },
    "calf_raise.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calf raises. Rise up onto your toes, pause, then lower slowly."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पंजों पर उठना। पंजों के बल ऊपर उठें, थोड़ा रुकें, फिर धीरे से नीचे आएं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elevación de talones. Sube sobre las puntas de los pies, haz una pausa y baja despacio."
          }
        }
      }
    },
    "calf_raise.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calf Raise"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पंजों पर उठना"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elevación de talones"
          }
        }
      }
    },
    "calf_raise.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold a wall or chair for support if you need it."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ज़रूरत हो तो सहारे के लिए दीवार या कुर्सी पकड़ लें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apóyate en una pared o una silla si lo necesitas."
          }
        }
      }
    },
    "chair_squat.cue.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Push your hips back."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कूल्हे पीछे ले जाएं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva la cadera hacia atrás."
          }
        }
      }
    },
    "chair_squat.cue.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just touch the seat."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बस सीट को छुएँ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo roza el asiento."
          }
        }
      }
    },
    "chair_squat.cue.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your chest up."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सीना ऊपर रखें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén el pecho arriba."
          }
        }
      }
    },
    "chair_squat.cue.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Heels stay on the floor."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एड़ियां ज़मीन पर टिकी रहें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los talones se quedan en el suelo."
          }
        }
      }
    },
    "chair_squat.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Squats to a chair. Stand in front of a sturdy chair, arms forward. Sit back until you just touch the seat, then stand tall without sitting down."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुर्सी तक स्क्वाट। मज़बूत कुर्सी के सामने खड़े हों, हाथ आगे। तब तक पीछे बैठें जब तक सीट को हल्का सा न छू लें, फिर बिना बैठे सीधे खड़े हों।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentadillas hasta la silla. Ponte delante de una silla firme con los brazos al frente. Échate hacia atrás hasta rozar el asiento y levántate sin llegar a sentarte."
          }
        }
      }
    },
    "chair_squat.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Squat to a Chair"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुर्सी तक स्क्वाट"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentadilla hasta la silla"
          }
        }
      }
    },
    "chair_squat.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a sturdy chair against a wall so it can't slide."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मज़बूत कुर्सी दीवार से सटाकर रखें, ताकि वह खिसके नहीं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa una silla firme apoyada contra la pared para que no se deslice."
          }
        }
      }
    },
    "chair_stand.cue.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lean forward slightly to stand."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खड़े होने के लिए थोड़ा आगे झुकें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclínate un poco hacia adelante para levantarte."
          }
        }
      }
    },
    "chair_stand.cue.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand all the way up."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरा सीधा खड़े हों।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Levántate del todo."
          }
        }
      }
    },
    "chair_stand.cue.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit down with control."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संभलकर, धीरे से बैठें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siéntate con control."
          }
        }
      }
    },
    "chair_stand.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chair stands. Sit in the middle of a chair, arms crossed on your chest. Stand up fully, then sit back down."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुर्सी से उठना। कुर्सी के बीच में बैठें, हाथ सीने पर क्रॉस करके। पूरी तरह खड़े हों, फिर वापस बैठ जाएं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Levantarse de la silla. Siéntate en el centro de una silla, con los brazos cruzados sobre el pecho. Ponte de pie por completo y luego vuelve a sentarte."
          }
        }
      }
    },
    "chair_stand.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chair Stand"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुर्सी से उठना"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Levantarse de la silla"
          }
        }
      }
    },
    "chair_stand.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a sturdy chair against a wall so it can't slide."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मज़बूत कुर्सी दीवार से सटाकर रखें, ताकि वह खिसके नहीं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa una silla firme apoyada contra la pared para que no se deslice."
          }
        }
      }
    },
    "chair_stand_hands.cue.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lean forward, then stand."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आगे झुकें, फिर खड़े हों।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclínate hacia delante y levántate."
          }
        }
      }
    },
    "chair_stand_hands.cue.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use your hands only as much as you need."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हाथों का उतना ही सहारा लें जितना ज़रूरी हो।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa las manos solo lo que necesites."
          }
        }
      }
    },
    "chair_stand_hands.cue.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit down with control."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नियंत्रण के साथ बैठें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siéntate con control."
          }
        }
      }
    },
    "chair_stand_hands.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chair stands with hands. Sit in the middle of a sturdy chair with your hands on your thighs. Push through your legs and hands to stand up fully, then sit back down slowly."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हाथों के सहारे कुर्सी से उठना। मज़बूत कुर्सी के बीच में बैठें और हाथ जाँघों पर रखें। पैरों और हाथों से ज़ोर लगाकर पूरी तरह खड़े हों, फिर धीरे से वापस बैठें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Levantarse de la silla con manos. Siéntate en el centro de una silla firme con las manos sobre los muslos. Empuja con las piernas y las manos hasta ponerte de pie del todo y vuelve a sentarte despacio."
          }
        }
      }
    },
    "chair_stand_hands.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chair Stand with Hands"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हाथों के सहारे कुर्सी से उठना"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Levantarse de la silla con manos"
          }
        }
      }
    },
    "chair_stand_hands.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a sturdy chair against a wall so it can't slide."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मज़बूत कुर्सी दीवार से सटाकर रखें ताकि वह खिसके नहीं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa una silla firme contra la pared para que no se deslice."
          }
        }
      }
    },
    "deep_squat_hold.cue.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Heels down if you can."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हो सके तो एड़ियां नीचे रखें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Talones en el suelo, si puedes."
          }
        }
      }
    },
    "deep_squat_hold.cue.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Elbows gently press knees out."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोहनियों से घुटनों को हल्के से बाहर दबाएं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los codos empujan suavemente las rodillas hacia afuera."
          }
        }
      }
    },
    "deep_squat_hold.cue.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Breathe into your hips."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कूल्हों तक गहरी सांस लें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva la respiración a las caderas."
          }
        }
      }
    },
    "deep_squat_hold.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deep squat, like Malasana. Feet a little wider, toes turned out, sink down and rest with palms together."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डीप स्क्वाट, मलासन की तरह। पैर थोड़े ज़्यादा खोलें, पंजे बाहर की ओर, नीचे बैठ जाएं और हथेलियां जोड़कर रुकें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentadilla profunda, como en la postura Malasana. Pies un poco más separados y puntas hacia afuera; baja y quédate ahí con las palmas juntas."
          }
        }
      }
    },
    "deep_squat_hold.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deep Squat Hold"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डीप स्क्वाट होल्ड"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentadilla profunda sostenida"
          }
        }
      }
    },
    "deep_squat_hold.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold a door frame or put a folded towel under your heels if that helps."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर मदद मिले, तो दरवाज़े की चौखट पकड़ें या एड़ियों के नीचे मुड़ा हुआ तौलिया रखें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sujétate al marco de una puerta o pon una toalla doblada bajo los talones si te ayuda."
          }
        }
      }
    },
    "feet_together_balance.cue.0": {
      "extractionState": "manual",
      "localizations": {
