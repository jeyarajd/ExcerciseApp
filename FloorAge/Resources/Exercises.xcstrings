          "stringUnit": {
            "state": "translated",
            "value": "Arrodíllate sobre una esterilla blanda o una toalla doblada, junto a una silla a la que puedas agarrarte."
          }
        }
      }
    },
    "low_chair_stand.cue.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lean forward slightly to stand."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खड़े होने के लिए थोड़ा आगे झुकें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclínate un poco hacia adelante para levantarte."
          }
        }
      }
    },
    "low_chair_stand.cue.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand all the way up."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरा सीधा खड़े हों।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Levántate del todo."
          }
        }
      }
    },
    "low_chair_stand.cue.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit down with control."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संभलकर, धीरे से बैठें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siéntate con control."
          }
        }
      }
    },
    "low_chair_stand.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Low chair stands. Use a lower seat, like a sturdy stool or a low sofa, arms crossed on your chest. Stand up fully, then sit back down slowly."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नीची कुर्सी से उठना। नीची सीट लें, जैसे मज़बूत स्टूल या नीचा सोफ़ा, हाथ सीने पर क्रॉस। पूरी तरह खड़े हों, फिर धीरे से वापस बैठें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Levantarse de una silla baja. Usa un asiento más bajo, como un taburete firme o un sofá bajo, con los brazos cruzados sobre el pecho. Ponte de pie del todo y vuelve a sentarte despacio."
          }
        }
      }
    },
    "low_chair_stand.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Low Chair Stand"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नीची कुर्सी से उठना"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Levantarse de una silla baja"
          }
        }
      }
    },
    "low_chair_stand.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a sturdy seat that can't slide or tip."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐसी मज़बूत सीट लें जो खिसके या पलटे नहीं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un asiento firme que no se deslice ni se vuelque."
          }
        }
      }
    },
    "march.cue.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lift those knees."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घुटने ऊपर उठाएं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Arriba esas rodillas!"
          }
        }
      }
    },
    "march.cue.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swing your arms."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हाथ आगे-पीछे हिलाएं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Balancea los brazos."
          }
        }
      }
    },
    "march.cue.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nice and steady."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आराम से, एक लय में।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritmo suave y constante."
          }
        }
      }
    },
    "march.cue.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep breathing."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सांस लेते रहें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue respirando."
          }
        }
      }
    },
    "march.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let's warm up. March in place, lift your knees and swing your arms."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चलिए, वार्म-अप करें। एक जगह पर कदमताल करें, घुटने उठाएं और हाथ हिलाएं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vamos a calentar. Marcha en el lugar, levanta las rodillas y balancea los brazos."
          }
        }
      }
    },
    "march.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "March in Place"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक जगह कदमताल"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcha en el lugar"
          }
        }
      }
    },
    "side_leg_raise.cue.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Toes point forward."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पंजे सामने की ओर रहें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La punta del pie mira hacia adelante."
          }
        }
      }
    },
    "side_leg_raise.cue.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't lean too far."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ज़्यादा न झुकें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No te inclines demasiado."
          }
        }
      }
    },
    "side_leg_raise.cue.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slow and controlled."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "धीरे और संभलकर।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lento y controlado."
          }
        }
      }
    },
    "side_leg_raise.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Side leg raises. Stand tall and lift one leg out to the side, then bring it back. We'll switch sides halfway."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पैर बगल में उठाना। सीधे खड़े हों और एक पैर बगल की ओर उठाएं, फिर वापस लाएं। आधे समय पर हम पैर बदलेंगे।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elevación lateral de pierna. Con el cuerpo erguido, levanta una pierna hacia el lado y vuelve a bajarla. A mitad cambiaremos de lado."
          }
        }
      }
    },
    "side_leg_raise.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Side Leg Raise"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पैर बगल में उठाना"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elevación lateral de pierna"
          }
        }
      }
    },
    "side_leg_raise.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold a chair for balance if you need it."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ज़रूरत हो तो संतुलन के लिए कुर्सी पकड़ लें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apóyate en una silla para mantener el equilibrio si lo necesitas."
          }
        }
      }
    },
    "single_leg_balance.cue.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand tall."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सीधे खड़े रहें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén el cuerpo erguido."
          }
        }
      }
    },
    "single_leg_balance.cue.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Soft knee on the standing leg."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिस पैर पर खड़े हैं, उसका घुटना हल्का ढीला रखें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rodilla de apoyo ligeramente flexionada."
          }
        }
      }
    },
    "single_leg_balance.cue.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Breathe slowly."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "धीरे-धीरे सांस लें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Respira despacio."
          }
        }
      }
    },
    "single_leg_balance.cue.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eyes on one spot."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नज़र एक जगह पर।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mirada fija en un punto."
          }
        }
      }
    },
    "single_leg_balance.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One leg balance. Lift one knee and hold. Keep your eyes on a spot in front of you."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक पैर पर संतुलन। एक घुटना ऊपर उठाएं और रोककर रखें। नज़र सामने किसी एक जगह पर टिकाएं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Equilibrio sobre una pierna. Levanta una rodilla y mantén la posición. Fija la mirada en un punto frente a ti."
          }
        }
      }
    },
    "single_leg_balance.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One-Leg Balance"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक पैर पर संतुलन"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Equilibrio sobre una pierna"
          }
        }
      }
    },
    "single_leg_balance.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand near a wall or chair you can hold if you wobble."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दीवार या कुर्सी के पास खड़े हों, ताकि लड़खड़ाने पर उसे पकड़ सकें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponte cerca de una pared o de una silla en la que puedas apoyarte si te tambaleas."
          }
        }
      }
    },
    "single_leg_balance_eyes_closed.Now close your eyes.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now close your eyes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब आँखें बंद करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora cierra los ojos."
          }
        }
      }
    },
    "single_leg_balance_eyes_closed.Open your eyes.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open your eyes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आँखें खोलें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre los ojos."
          }
        }
      }
    },
    "single_leg_balance_eyes_closed.cue.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find your balance first."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले संतुलन बनाएँ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero encuentra el equilibrio."
          }
        }
      }
    },
    "single_leg_balance_eyes_closed.cue.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now close your eyes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब आँखें बंद करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora cierra los ojos."
          }
        }
      }
    },
    "single_leg_balance_eyes_closed.cue.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Breathe slowly."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "धीरे-धीरे सांस लें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Respira despacio."
          }
        }
      }
    },
    "single_leg_balance_eyes_closed.cue.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open them if you wobble."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डगमगाएँ तो आँखें खोल लें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ábrelos si te tambaleas."
          }
        }
      }
    },
    "single_leg_balance_eyes_closed.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One leg balance with your eyes closed. Stand right next to a wall or chair. Lift one knee, find your balance, then close your eyes and hold."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आँखें बंद करके एक पैर पर संतुलन। दीवार या कुर्सी के ठीक पास खड़े हों। एक घुटना उठाएँ, संतुलन बनाएँ, फिर आँखें बंद करके रुकें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Equilibrio a una pierna con los ojos cerrados. Ponte justo al lado de una pared o una silla. Levanta una rodilla, busca el equilibrio, cierra los ojos y aguanta."
          }
        }
      }
    },
    "single_leg_balance_eyes_closed.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One-Leg Balance, Eyes Closed"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आँखें बंद करके एक पैर पर संतुलन"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Equilibrio a una pierna con ojos cerrados"
          }
        }
      }
    },
    "single_leg_balance_eyes_closed.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only with a wall or sturdy chair within reach. Skip this one if you get dizzy."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ तब करें जब दीवार या मज़बूत कुर्सी पास हो। चक्कर आते हों तो इसे छोड़ दें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo con una pared o una silla firme al alcance. Sáltatelo si te mareas."
          }
        }
      }
    },
    "single_leg_calf_raise.cue.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rise straight up."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सीधे ऊपर उठें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube recto."
          }
        }
      }
    },
    "single_leg_calf_raise.cue.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause at the top."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऊपर रुकें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa arriba."
          }
        }
      }
    },
    "single_leg_calf_raise.cue.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower slowly."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "धीरे से नीचे आएँ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja despacio."
          }
        }
      }
    },
    "single_leg_calf_raise.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One-leg calf raises. Hold the back of a sturdy chair, lift one foot behind you, and rise up onto the toes of the other. Lower slowly. We'll switch legs halfway."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक पैर पर काफ़ रेज़। मज़बूत कुर्सी की पीठ पकड़ें, एक पैर पीछे उठाएँ, और दूसरे पैर के पंजों पर ऊपर उठें। धीरे से नीचे आएँ। आधे समय पर पैर बदलेंगे।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elevación de talón a una pierna. Sujeta el respaldo de una silla firme, levanta un pie por detrás y sube de puntillas con el otro. Baja despacio. A mitad cambiaremos de pierna."
          }
        }
      }
    },
    "single_leg_calf_raise.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One-Leg Calf Raise"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक पैर पर काफ़ रेज़"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elevación de talón a una pierna"
          }
        }
      }
    },
    "single_leg_calf_raise.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep a hand on the chair until you feel steady."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक संतुलन न बने, एक हाथ कुर्सी पर रखें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén una mano en la silla hasta que te sientas estable."
          }
        }
      }
    },
    "single_leg_calf_raise_free.cue.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rise straight up."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सीधे ऊपर उठें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube en línea recta."
          }
        }
      }
    },
    "single_leg_calf_raise_free.cue.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause at the top."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऊपर थोड़ा रुकें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa arriba."
          }
        }
      }
    },
    "single_leg_calf_raise_free.cue.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower slowly."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "धीरे से नीचे आएं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja despacio."
          }
        }
      }
    },
    "single_leg_calf_raise_free.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One-leg calf raises without holding on. Stand next to a chair, lift one foot behind you and rise up onto the toes of the other. Lower slowly. We'll switch legs halfway."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिना पकड़े एक पैर पर काफ़ रेज़। कुर्सी के पास खड़े हों, एक पैर पीछे उठाएँ और दूसरे पैर के पंजों पर ऊपर उठें। धीरे से नीचे आएँ। आधे समय पर पैर बदलेंगे।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elevación de talón a una pierna sin sujetarte. Ponte junto a una silla, levanta un pie por detrás y sube de puntillas con el otro. Baja despacio. A mitad cambiaremos de pierna."
          }
        }
      }
    },
    "single_leg_calf_raise_free.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One-Leg Calf Raise, No Hands"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिना हाथों के एक पैर पर काफ़ रेज़"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elevación de talón a una pierna sin manos"
          }
        }
      }
    },
    "single_leg_calf_raise_free.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the chair right next to you and grab it if you wobble."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुर्सी ठीक बगल में रखें और डगमगाएँ तो उसे पकड़ लें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten la silla justo al lado y agárrala si te tambaleas."
          }
        }
      }
    },
    "sit_rise.cue.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arms forward for balance."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संतुलन के लिए हाथ आगे रखें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Brazos al frente para mantener el equilibrio."
          }
        }
      }
    },
    "sit_rise.cue.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go slow and controlled."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "धीरे और संभलकर।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Despacio y con control."
          }
        }
      }
    },
    "sit_rise.cue.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lean forward to rise."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उठने के लिए आगे झुकें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclínate hacia adelante para subir."
          }
        }
      }
    },
    "sit_rise.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit to rise. Cross your legs and lower yourself to the floor, then stand back up. Try not to use your hands or knees."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैठकर उठना। पैर क्रॉस करें और धीरे-धीरे ज़मीन पर बैठें, फिर वापस खड़े हो जाएं। कोशिश करें कि हाथ या घुटनों का सहारा न लें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentarse y levantarse del suelo. Cruza las piernas y baja hasta el suelo; luego vuelve a ponerte de pie. Intenta no usar las manos ni las rodillas."
          }
        }
      }
    },
    "sit_rise.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit to Rise"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैठकर उठना"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentarse y levantarse del suelo"
          }
        }
      }
    },
    "sit_rise.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skip this if you have knee or hip pain. Practise on a soft mat."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर घुटने या कूल्हे में दर्द हो, तो इसे छोड़ दें। नरम मैट पर अभ्यास करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sáltate este ejercicio si tienes dolor de rodilla o de cadera. Practica sobre una colchoneta blanda."
          }
        }
      }
    },
    "squat.cue.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Push your hips back."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कूल्हे पीछे ले जाएं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva la cadera hacia atrás."
          }
        }
      }
    },
    "squat.cue.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your chest up."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सीना ऊपर रखें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén el pecho arriba."
          }
        }
      }
    },
    "squat.cue.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Knees follow your toes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घुटने पंजों की सीध में रहें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las rodillas apuntan hacia los dedos de los pies."
          }
        }
      }
    },
    "squat.cue.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Heels stay on the floor."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एड़ियां ज़मीन पर टिकी रहें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los talones se quedan en el suelo."
          }
        }
      }
    },
    "squat.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Squats. Feet shoulder width apart, arms forward. Sit back like there is a chair behind you, then stand tall."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्वाट। पैर कंधों जितने खुले, हाथ सामने। ऐसे पीछे बैठें जैसे पीछे कुर्सी रखी हो, फिर सीधे खड़े हो जाएं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentadillas. Pies separados al ancho de los hombros y brazos al frente. Baja hacia atrás como si tuvieras una silla detrás, y luego sube con el cuerpo bien erguido."
          }
        }
      }
    },
    "squat.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Squat"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्वाट"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentadilla"
          }
        }
      }
    },
    "squat.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only go as low as feels comfortable. Put a chair behind you if you're unsure."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उतना ही नीचे जाएं जितना आरामदायक लगे। पक्का न हो तो पीछे एक कुर्सी रख लें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja solo hasta donde te resulte cómodo. Si tienes dudas, pon una silla detrás de ti."
          }
        }
      }
    },
    "supported_calf_raise.cue.0": {
      "extractionState": "manual",
