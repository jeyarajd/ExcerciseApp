            "value": "Aprieta y eleva"
          }
        }
      }
    },
    "kegel.cue.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep breathing normally."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सामान्य रूप से सांस लेते रहें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue respirando con normalidad."
          }
        }
      }
    },
    "kegel.cue.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your belly, buttocks and thighs relaxed."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पेट, नितंब और जांघें ढीली रखें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén relajados el abdomen, los glúteos y los muslos."
          }
        }
      }
    },
    "kegel.cue.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Relax completely between squeezes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर बार सिकोड़ने के बीच पूरी तरह ढीला छोड़ें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Relaja por completo entre contracciones."
          }
        }
      }
    },
    "kegel.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelvic floor squeezes, also called Kegels. Sit tall. Squeeze the muscles you use to hold in urine and wind, lift them up and in, hold while I count, then relax fully."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पेल्विक फ़्लोर स्क्वीज़, जिन्हें कीगल भी कहते हैं। सीधे बैठें। वे मांसपेशियां सिकोड़ें जिनसे आप पेशाब और गैस रोकते हैं, उन्हें ऊपर और अंदर की ओर खींचें, जब तक मैं गिनूं रोककर रखें, फिर पूरी तरह ढीला छोड़ दें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contracciones del suelo pélvico, también llamadas ejercicios de Kegel. Siéntate con la espalda recta. Aprieta los músculos que usas para retener la orina y los gases, elévalos hacia arriba y hacia dentro, mantén mientras cuento y luego relaja por completo."
          }
        }
      }
    },
    "kegel.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelvic Floor Squeeze"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पेल्विक फ़्लोर स्क्वीज़"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contracción del suelo pélvico"
          }
        }
      }
    },
    "kegel.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't practise while you're actually passing urine. If you have pelvic pain, or leaking that doesn't get better, see a doctor or a pelvic health physiotherapist."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पेशाब करते समय यह अभ्यास न करें। अगर पेल्विक हिस्से में दर्द हो, या पेशाब का रिसाव ठीक न हो रहा हो, तो डॉक्टर या पेल्विक हेल्थ फ़िज़ियोथेरेपिस्ट से मिलें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No lo practiques mientras estés orinando. Si tienes dolor pélvico o pérdidas de orina que no mejoran, consulta a un médico o a un fisioterapeuta especializado en suelo pélvico."
          }
        }
      }
    },
    "kneel_to_stand.cue.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower slowly."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "धीरे से नीचे जाएँ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja despacio."
          }
        }
      }
    },
    "kneel_to_stand.cue.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Push through the front heel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आगे की एड़ी से ज़ोर लगाएँ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empuja con el talón de delante."
          }
        }
      }
    },
    "kneel_to_stand.cue.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand all the way up."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरी तरह खड़े हों।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponte de pie del todo."
          }
        }
      }
    },
    "kneel_to_stand.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kneel to stand. Step back and lower one knee gently to the mat, then push through your front foot to stand up again. Use your hands on your front knee if you need them."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घुटने से खड़े होना। पीछे क़दम रखें और एक घुटना धीरे से मैट पर टिकाएँ, फिर आगे वाले पैर से ज़ोर लगाकर फिर खड़े हों। ज़रूरत हो तो हाथ आगे वाले घुटने पर रखें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De rodillas a de pie. Da un paso atrás y apoya una rodilla suavemente en la esterilla; luego empuja con el pie de delante para volver a ponerte de pie. Apoya las manos en la rodilla de delante si lo necesitas."
          }
        }
      }
    },
    "kneel_to_stand.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kneel to Stand"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घुटने से खड़े होना"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De rodillas a de pie"
          }
        }
      }
    },
    "kneel_to_stand.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kneel on a soft mat or a folded towel, next to a chair you can hold."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नरम मैट या मुड़े हुए तौलिये पर घुटना टेकें, पास में एक कुर्सी रखें जिसे पकड़ सकें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrodíllate sobre una esterilla blanda o una toalla doblada, junto a una silla a la que puedas agarrarte."
          }
        }
      }
    },
