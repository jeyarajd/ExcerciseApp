    },
    "supported_calf_raise.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calf raises at a chair. Stand behind a sturdy chair and hold its back. Rise up onto your toes, pause, then lower slowly."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुर्सी पकड़कर काफ़ रेज़। मज़बूत कुर्सी के पीछे खड़े होकर उसकी पीठ पकड़ें। पंजों पर ऊपर उठें, रुकें, फिर धीरे से नीचे आएँ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elevación de talones en la silla. Ponte detrás de una silla firme y sujeta el respaldo. Sube de puntillas, haz una pausa y baja despacio."
          }
        }
      }
    },
    "supported_calf_raise.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calf Raise at a Chair"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुर्सी पकड़कर काफ़ रेज़"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elevación de talones en la silla"
          }
        }
      }
    },
    "supported_calf_raise.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a sturdy chair that can't tip or slide."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐसी मज़बूत कुर्सी लें जो पलटे या खिसके नहीं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa una silla firme que no pueda volcar ni deslizarse."
          }
        }
      }
    },
    "tandem_stance.cue.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Heel to toe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एड़ी से पंजा।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Talón con punta."
          }
        }
      }
    },
    "tandem_stance.cue.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand tall."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सीधे खड़े रहें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantente erguido."
          }
        }
      }
    },
    "tandem_stance.cue.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eyes on one spot."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नज़र एक जगह पर।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mirada en un punto."
          }
        }
      }
    },
    "tandem_stance.cue.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Breathe slowly."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "धीरे-धीरे साँस लें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Respira despacio."
          }
        }
      }
    },
    "tandem_stance.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tandem stance. Put one foot straight in front of the other, heel touching toe, like standing on a line. Hold, then we'll swap feet halfway."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टैंडम स्टांस। एक पैर को दूसरे के ठीक आगे रखें, एड़ी पंजे को छूती हुई, जैसे किसी रेखा पर खड़े हों। रुकें, फिर आधे समय पर पैर बदलेंगे।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Postura en tándem. Pon un pie justo delante del otro, el talón tocando la punta, como si estuvieras sobre una línea. Aguanta y a mitad cambiaremos de pie."
          }
        }
      }
    },
    "tandem_stance.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tandem Stance"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टैंडम स्टांस"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Postura en tándem"
          }
        }
      }
    },
    "tandem_stance.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand next to a wall or kitchen counter you can touch if you wobble."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दीवार या रसोई के काउंटर के पास खड़े हों ताकि डगमगाने पर छू सकें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponte junto a una pared o la encimera para poder tocarla si te tambaleas."
          }
        }
      }
    },
    "toe_reach.cue.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let your head hang."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर को ढीला लटकने दें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja caer la cabeza."
          }
        }
      }
    },
    "toe_reach.cue.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Breathe out as you reach."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नीचे जाते हुए सांस छोड़ें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suelta el aire al bajar."
          }
        }
      }
    },
    "toe_reach.cue.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Roll up slowly."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "धीरे-धीरे ऊपर आएं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube despacio, enrollando la espalda."
          }
        }
      }
    },
    "toe_reach.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Toe reach. Knees soft, fold forward from your hips and let your hands reach toward your toes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पंजे छूना। घुटने हल्के ढीले, कूल्हों से आगे झुकें और हाथों को पंजों की ओर जाने दें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocar los pies. Con las rodillas ligeramente flexionadas, inclínate hacia adelante desde la cadera y deja que las manos bajen hacia los dedos de los pies."
          }
        }
      }
    },
    "toe_reach.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Toe Reach"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पंजे छूना"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocar los pies"
          }
        }
      }
    },
    "toe_reach.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never bounce. Stop at a gentle stretch, not pain."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कभी झटका न दें। हल्का खिंचाव महसूस होते ही रुक जाएं, दर्द तक न जाएं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca rebotes. Detente al notar un estiramiento suave, no dolor."
          }
        }
      }
    },
    "wall_sit.cue.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back flat on the wall."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पीठ दीवार से सटी रहे।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espalda pegada a la pared."
          }
        }
      }
    },
    "wall_sit.cue.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Knees over your ankles."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घुटने टखनों के ऊपर।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rodillas sobre los tobillos."
          }
        }
      }
    },
    "wall_sit.cue.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep breathing."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साँस लेते रहें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue respirando."
          }
        }
      }
    },
    "wall_sit.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wall sit. Stand with your back flat against a wall, feet a step forward. Slide down until your knees bend, like sitting on an invisible chair, and hold."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉल सिट। पीठ दीवार से सटाकर खड़े हों, पैर एक क़दम आगे। घुटने मुड़ने तक नीचे सरकें, जैसे किसी अदृश्य कुर्सी पर बैठे हों, और रुकें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentadilla en la pared. Ponte de pie con la espalda apoyada en la pared y los pies un paso por delante. Deslízate hacia abajo hasta doblar las rodillas, como si te sentaras en una silla invisible, y aguanta."
          }
        }
      }
    },
    "wall_sit.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wall Sit"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉल सिट"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentadilla en la pared"
          }
        }
      }
    },
    "wall_sit.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only slide as low as feels comfortable for your knees."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उतना ही नीचे जाएँ जितना घुटनों को आराम से ठीक लगे।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja solo hasta donde tus rodillas estén cómodas."
          }
        }
      }
    }
  },
  "version": "1.0"
}