    "kneel_to_stand_free.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kneel to stand without your hands. Step back and lower one knee gently to the mat, then push through your front foot to stand up, arms forward for balance."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिना हाथों के घुटने से खड़े होना। पीछे क़दम रखें और एक घुटना धीरे से मैट पर टिकाएँ, फिर आगे वाले पैर से ज़ोर लगाकर खड़े हों, संतुलन के लिए हाथ आगे।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De rodillas a de pie sin manos. Da un paso atrás y apoya una rodilla suavemente en la esterilla; luego empuja con el pie de delante para levantarte, con los brazos al frente para equilibrarte."
          }
        }
      }
    },
