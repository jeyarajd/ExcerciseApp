            "value" : "आज का सेशन पूरा हुआ। आज आपने समय निकाला, बहुत बढ़िया!"
          }
        }
      }
    },
    "The App Store couldn't confirm this purchase. Please try Restore Purchases." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
