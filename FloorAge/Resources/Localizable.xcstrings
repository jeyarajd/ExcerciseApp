        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आवाज़ सुनें"
          }
        }
      }
    },
    "That's it, well done! Walking and running like this is how fitness builds." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Eso es, bien hecho! Caminando y corriendo así es como se gana forma física."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बस, बहुत बढ़िया! ऐसे ही चलने और दौड़ने से फ़िटनेस बनती है।"
          }
        }
      }
    },
    "That's the session done. Great job showing up today!" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
