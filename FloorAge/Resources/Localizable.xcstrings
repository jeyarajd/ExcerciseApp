    },
    "Test and coach your parents or partner on this iPhone, each with their own Floor Age and plan." : {
      "localizations" : {
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसी iPhone पर अपने माता-पिता या जीवनसाथी का टेस्ट और कोचिंग करें, हर किसी का अपना Floor Age और प्लान।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evalúa y entrena a tus padres o a tu pareja en este iPhone, cada uno con su propio Floor Age y plan."
          }
        }
      }
    },
    "Test voice" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
