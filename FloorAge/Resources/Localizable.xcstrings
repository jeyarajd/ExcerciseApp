    "One notification a day, only if you haven't done that day's training yet. You can change the time in Settings." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una notificación al día, solo si aún no has hecho el entrenamiento de ese día. Puedes cambiar la hora en Ajustes."
          }
