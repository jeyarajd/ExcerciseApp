            "value" : "आपकी Floor Age"
          }
        }
      }
    },
    "Your Floor Age chart and every past check." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu gráfica de Floor Age y todas tus pruebas anteriores."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका Floor Age चार्ट और हर पिछला चेक।"
          }
        }
      }
    },
    "Your Floor Age check" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu prueba Floor Age"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी Floor Age जांच"
          }
        }
      }
    },
    "Your Floor Age is %lld. Brilliant, your body moves younger than your age!" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu Floor Age es %lld. ¡Genial, tu cuerpo se mueve como si tuvieras menos edad!"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी Floor Age %lld है। शानदार, आपके शरीर की चाल आपकी उम्र से ज़्यादा जवान है!"
          }
        }
      }
    },
    "Your Floor Age is %lld. That's %lld years above your age, and we'll work on it together." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your Floor Age is %1$lld. That's %2$lld years above your age, and we'll work on it together."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu Floor Age es %1$lld. Son %2$lld años más que tu edad, y vamos a trabajarlo en equipo."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी Floor Age %1$lld है। यह आपकी उम्र से %2$lld साल ज़्यादा है, और हम मिलकर इस पर काम करेंगे।"
          }
        }
      }
    },
    "Your photo" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu foto"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी फ़ोटो"
          }
        }
      }
    },
    "Your photo is checked on this iPhone and never saved or sent. Photos can't show portion size, so set the servings yourself." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu foto se analiza en este iPhone y nunca se guarda ni se envía. Una foto no muestra el tamaño de la porción, así que indica tú las porciones."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी फ़ोटो की जांच इसी iPhone पर होती है, और वह कभी सेव नहीं होती, न कहीं भेजी जाती है। फ़ोटो से मात्रा का पता नहीं चलता, इसलिए मात्रा खुद चुनें।"
          }
        }
      }
    },
    "Your plan" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu plan"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका प्लान"
          }
        }
      }
    },
    "Your plan now focuses on %@. Retest in about 4 weeks to see your Floor Age drop." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora tu plan se centra en %@. Repite la prueba en unas 4 semanas para ver cómo baja tu Floor Age."
