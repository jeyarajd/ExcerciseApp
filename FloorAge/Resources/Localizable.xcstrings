            "value" : "Cámara activada"
          }
        }
      }
    },
    "Can you get up off the floor without using your hands?" : {
      "localizations" : {
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्या आप हाथों का सहारा लिए बिना ज़मीन से उठ सकते हैं?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Puedes levantarte del suelo sin usar las manos?"
          }
        }
      }
    },
    "Cancel" : {
      "localizations" : {
