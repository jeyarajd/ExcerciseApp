    },
    "Log how you slept to see your nights here." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra cómo dormiste para ver tus noches aquí."
          }
        },
        "hi" : {
          "stringUnit" : {
