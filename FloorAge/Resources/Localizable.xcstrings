          }
        }
      }
    },
    "Change or restart plan" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambiar o reiniciar el plan"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्लान बदलें या फिर से शुरू करें"
          }
        }
      }
    },
    "Check with your doctor before starting if you have a heart, lung or joint condition, are pregnant, or haven't been active for a long time." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta a tu médico antes de empezar si tienes una afección cardíaca, pulmonar o articular, si estás embarazada o si llevas mucho tiempo sin hacer actividad física."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर आपको दिल, फेफड़ों या जोड़ों की कोई बीमारी है, आप गर्भवती हैं, या लंबे समय से सक्रिय नहीं रहे हैं, तो शुरू करने से पहले अपने डॉक्टर से सलाह लें।"
          }
        }
      }
    },
    "Checks" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pruebas"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पिछली जांचें"
          }
        }
      }
    },
    "Close" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
