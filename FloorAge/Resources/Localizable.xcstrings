          }
        }
      }
    },
    "The green band is the recommended %@ for your age (National Sleep Foundation)." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La franja verde marca las %@ recomendadas para tu edad (National Sleep Foundation)."
