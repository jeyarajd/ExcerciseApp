        }
      }
    },
    "WHO guidelines on physical activity (2020)" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Directrices de la OMS sobre actividad física (2020)"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शारीरिक गतिविधि पर WHO के दिशानिर्देश (2020)"
          }
        }
      }
    },
    "WHO international ranges: healthy 18.5–24.9. If you're of South Asian, Chinese or other Asian descent, the Asian ranges fit better." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rangos internacionales de la OMS: saludable 18,5–24,9. Si tu origen es del sur de Asia, de China o de otra parte de Asia, los rangos asiáticos se ajustan mejor."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WHO की अंतरराष्ट्रीय रेंज: स्वस्थ 18.5–24.9। अगर आप दक्षिण एशियाई, चीनी या किसी और एशियाई मूल के हैं, तो एशियाई रेंज ज़्यादा सही बैठती है।"
          }
        }
      }
    },
    "Who's training?" : {
      "localizations" : {
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कौन ट्रेनिंग कर रहा है?"
