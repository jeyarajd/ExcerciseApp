    "Find your Floor Age" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descubre tu Floor Age"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपनी Floor Age जानें"
          }
        }
      }
    },
    "Find your Floor Age with 4 simple tests, then train with a coach who shows every move and talks you through it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descubre tu Floor Age con 4 pruebas sencillas y luego entrena con un coach que te muestra cada movimiento y te guía con su voz."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4 आसान टेस्ट से अपनी Floor Age जानें, फिर ऐसे कोच के साथ ट्रेनिंग करें जो हर मूव करके दिखाए और बोलकर समझाए।"
          }
        }
      }
    },
    "Find your Floor Age: 4 tests, 10 minutes. Scan to get the app." : {
      "localizations" : {
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपना Floor Age जानें: 4 टेस्ट, 10 मिनट। ऐप पाने के लिए स्कैन करें।"
          }
        },
        "es" : {
          "stringUnit" : {
