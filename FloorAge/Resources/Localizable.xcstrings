        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हरी पट्टी आपकी उम्र के लिए सुझाए गए %@ दिखाती है (National Sleep Foundation)।"
          }
        }
      }
    },
    "the owner" : {
      "localizations" : {
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ोन के मालिक"
