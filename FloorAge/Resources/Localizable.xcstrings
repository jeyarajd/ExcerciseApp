    "Small steps add up: daily walks and your 10-minute sessions make a real difference." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los pequeños pasos suman: las caminatas diarias y tus sesiones de 10 minutos marcan una diferencia real."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "छोटी-छोटी कोशिशें जुड़ती जाती हैं: रोज़ की वॉक और आपके 10 मिनट के सेशन से सच में फ़र्क पड़ता है।"
          }
        }
      }
    },
    "Snap your plate" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
