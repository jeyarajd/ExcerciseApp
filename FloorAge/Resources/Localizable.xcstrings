          }
        }
      }
    },
    "Snap your plate for calorie suggestions, checked on your iPhone." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz una foto de tu plato y recibe sugerencias de calorías, analizadas en tu iPhone."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपनी प्लेट की फ़ोटो लें और कैलोरी के सुझाव पाएं, जांच आपके iPhone पर ही होती है।"
