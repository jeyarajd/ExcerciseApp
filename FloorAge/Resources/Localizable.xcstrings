          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कैलोरी (kcal)"
          }
        }
      }
    },
    "Calories are typical values for home portions and vary with recipe and oil." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las calorías son valores típicos de porciones caseras y varían según la receta y el aceite."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कैलोरी घर की आम मात्रा के हिसाब से अंदाज़न हैं, और रेसिपी व तेल के हिसाब से बदलती हैं।"
          }
        }
      }
    },
    "Camera access is off. Allow it in iPhone Settings › Privacy & Security › Camera." : {
      "localizations" : {
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कैमरा की अनुमति बंद है। iPhone सेटिंग्स › गोपनीयता और सुरक्षा › कैमरा में इसे चालू करें।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso a la cámara está desactivado. Actívalo en Ajustes del iPhone › Privacidad y seguridad › Cámara."
          }
        }
      }
    },
    "Camera on" : {
      "localizations" : {
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कैमरा चालू"
          }
        },
        "es" : {
          "stringUnit" : {
