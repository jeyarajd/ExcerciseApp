      }
    },
    "Step back so your feet are in view" : {
      "localizations" : {
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "थोड़ा पीछे हटें ताकि आपके पैर दिखें"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aléjate un poco para que se vean tus pies"
          }
        }
      }
    },
    "Step counting is off. Turn on Motion & Fitness for Floor Age in iPhone Settings › Privacy & Security." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El conteo de pasos está desactivado. Activa Movimiento y forma física para Floor Age en Ajustes del iPhone › Privacidad y seguridad."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कदम गिनना बंद है। iPhone सेटिंग्स › गोपनीयता और सुरक्षा में जाकर Floor Age के लिए गति और फ़िटनेस चालू करें।"
          }
        }
      }
    },
    "Step into view, 2–3 m from the phone" : {
      "localizations" : {
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ोन से 2–3 मीटर दूर, कैमरे के सामने आएं"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponte delante de la cámara, a 2–3 m del teléfono"
          }
        }
