    "BMI calculator" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calculadora de IMC"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BMI कैलकुलेटर"
          }
        }
      }
    },
    "BMI doesn't account for muscle, so treat it as a rough guide, not a diagnosis." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El IMC no tiene en cuenta el músculo, así que tómalo como una guía aproximada, no como un diagnóstico."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BMI मांसपेशियों को नहीं गिनता, इसलिए इसे एक मोटा अंदाज़ा मानें, डायग्नोसिस नहीं।"
          }
        }
      }
    },
    "BMI ranges" : {
