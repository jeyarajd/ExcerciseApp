    },
    "Benefits of walking level off at 8,000–10,000 steps a day under 60, and 6,000–8,000 from 60." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los beneficios de caminar se estabilizan en 8000–10 000 pasos al día antes de los 60 años, y en 6000–8000 a partir de los 60."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चलने का फ़ायदा 60 से कम उम्र में रोज़ 8,000–10,000 कदम तक, और 60 की उम्र से 6,000–8,000 कदम तक बढ़ता है, फिर लगभग स्थिर हो जाता है।"
          }
        }
      }
    },
