    "Well short of the %@ most adults need. Try an earlier, regular bedtime." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muy por debajo de las %@ que necesita la mayoría de los adultos. Intenta acostarte más temprano y siempre a la misma hora."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ज़्यादातर वयस्कों को ज़रूरी %@ से काफ़ी कम। रोज़ एक तय समय पर, थोड़ा जल्दी सोने की कोशिश करें।"
