        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "9 हफ़्ते, हर हफ़्ते दौड़/वॉक के 3 सेशन, धीरे-धीरे 30 मिनट की दौड़ तक।"
          }
        }
      }
    },
    "12 guided Kegel squeezes · about 2 min. Do them sitting, anywhere." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12 contracciones de Kegel guiadas · unos 2 min. Hazlas en posición sentada, en cualquier lugar."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12 गाइडेड कीगल स्क्वीज़ · लगभग 2 मिनट। बैठकर, कहीं भी करें।"
          }
        }
      }
    },
    "12 weeks of brisk walking on 5 days, from 20 minutes up to %@ a day (%@ min a week), plus 2 strength days." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "12 weeks of brisk walking on 5 days, from 20 minutes up to %1$@ a day (%2$@ min a week), plus 2 strength days."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12 semanas de caminata rápida 5 días a la semana, de 20 minutos hasta %1$@ al día (%2$@ min a la semana), más 2 días de fuerza."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12 हफ़्ते, हफ़्ते में 5 दिन तेज़ वॉक, रोज़ 20 मिनट से बढ़ाकर %1$@ तक (हफ़्ते में %2$@ मिनट), साथ में 2 दिन स्ट्रेंथ।"
          }
        }
      }
    },
    "12 weeks of easy walking on 5 days, from 10 minutes up to %@ a day, plus 2 gentle strength days with a chair." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12 semanas de caminata suave 5 días a la semana, de 10 minutos hasta %@ al día, más 2 días de fuerza suave con una silla."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12 हफ़्ते, हफ़्ते में 5 दिन आराम से वॉक, रोज़ 10 मिनट से बढ़ाकर %@ तक, साथ में कुर्सी के सहारे 2 दिन हल्की स्ट्रेंथ।"
