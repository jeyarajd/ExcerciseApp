    },
    "The picture shows your Floor Age and areas, never your name. It's shared only where you choose." : {
      "localizations" : {
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तस्वीर में आपका Floor Age और हर हिस्से का नतीजा दिखता है, आपका नाम कभी नहीं। यह सिर्फ़ वहीं शेयर होती है जहां आप चुनें।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La imagen muestra tu Floor Age y tus áreas, nunca tu nombre. Solo se comparte donde tú elijas."
          }
        }
