    },
    "Based on what you told us, skip this test or do it only if it feels completely safe." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por lo que nos contaste, sáltate esta prueba o hazla solo si te parece totalmente segura."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपने जो बताया है, उसके हिसाब से यह टेस्ट छोड़ दें, या तभी करें जब यह पूरी तरह सुरक्षित लगे।"
          }
        }
      }
    },
    "Based on your %@, we recommend this plan: %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Based on your %1$@, we recommend this plan: %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Según %1$@, te recomendamos este plan: %2$@."
