        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अब आपका प्लान %@ पर ध्यान देगा। लगभग 4 हफ़्ते बाद फिर से जांच करें और देखें कि आपकी Floor Age कितनी घटी।"
          }
        }
      }
    },
    "Your purchase is waiting for approval. Plus unlocks as soon as it's approved." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
