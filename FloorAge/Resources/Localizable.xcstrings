    "%@ I'm your coach. Let's find out how old your body moves, and make it younger." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Voy a entrenarte. Vamos a descubrir qué edad tiene tu cuerpo al moverse, y a rejuvenecerlo."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ कोच के रूप में मैं आपके साथ हूं। चलिए पता करते हैं कि आपका शरीर किस उम्र जैसा चलता है, और उसे और जवान बनाते हैं।"
