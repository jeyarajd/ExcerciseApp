    "Asian" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asiático"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एशियाई"
          }
        }
      }
    },
    "Asian ranges (healthy 18.5–22.9) are recommended for people of Asian descent, whose health risks start at a lower BMI." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los rangos asiáticos (saludable 18,5–22,9) se recomiendan para personas de origen asiático, cuyos riesgos para la salud empiezan con un IMC más bajo."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एशियाई मूल के लोगों के लिए एशियाई रेंज (स्वस्थ 18.5–22.9) की सलाह दी जाती है, क्योंकि उनमें सेहत के जोखिम कम BMI पर ही शुरू हो जाते हैं।"
          }
        }
      }
    },
