        }
      }
    },
    "9 weeks, 3 run/walk sessions a week (about 30 min), building from 1-minute runs to 30 minutes of running, plus 2 strength days." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "9 semanas, 3 sesiones semanales de correr y caminar (unos 30 min), empezando con carreras de 1 minuto hasta llegar a 30 minutos corriendo, más 2 días de fuerza."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "9 हफ़्ते, हर हफ़्ते दौड़/वॉक के 3 सेशन (लगभग 30 मिनट), 1 मिनट की दौड़ से बढ़ते हुए 30 मिनट की दौड़ तक, साथ में 2 दिन स्ट्रेंथ।"
          }
        }
      }
    },
    "9 weeks, 3 run/walk sessions a week building to 30 minutes of running." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "9 semanas, 3 sesiones semanales de correr y caminar hasta llegar a 30 minutos corriendo."
          }
