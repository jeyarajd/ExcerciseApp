            "value" : "तेज़ वॉक"
          }
        }
      }
    },
    "brisk walking burns fat while being kind to your joints" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "caminar a paso rápido quema grasa y cuida tus articulaciones"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तेज़ वॉक से चर्बी घटती है और जोड़ों पर ज़्यादा ज़ोर भी नहीं पड़ता"
