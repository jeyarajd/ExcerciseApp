          }
        }
      }
    },
    "Missed a day? No problem. Consistency beats perfection." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Te saltaste un día? No pasa nada. La constancia vale más que la perfección."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक दिन छूट गया? कोई बात नहीं। हर बार एकदम सही करने से ज़्यादा ज़रूरी है लगातार करते रहना।"
          }
        }
      }
    },
    "More than 250 min a week for weight loss; beginners train strength 2–3 days, 8–12 reps, 1–3 sets." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más de 250 min a la semana para perder peso; quienes empiezan entrenan fuerza 2–3 días, 8–12 rep., 1–3 series."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वज़न घटाने के लिए हफ़्ते में 250 मिनट से ज़्यादा; शुरुआत करने वाले 2–3 दिन स्ट्रेंथ ट्रेनिंग करें, 8–12 रेप्स, 1–3 सेट।"
          }
        }
      }
    },
    "moves like %lld" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "se mueve como a los %lld"
